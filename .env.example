# Copiar a .env. No se envía nada por defecto.
SOURCE=FIXTURE
FIXTURE_COUNT=100
HOLIDAY_MODE=FIXTURE
MAIL_MODE=DRY_RUN
MAIL_ADAPTER=GMAIL
PROFILE=demo
BATCH_SIZE=100
GRAPH_PAGE_SIZE=100
PERIOD_START=2026-01-01T00:00:00Z
PERIOD_END=2027-01-01T00:00:00Z
BUSINESS_DAYS=3
MAX_ATTEMPTS=3
HTTP_TIMEOUT=20
BATCH_SECONDS=60
EXECUTION_SECONDS=600
CACHE_HOURS=168
RUNTIME_DIR=runtime
OUTPUT_DIR=output
REQUIRE_EXCEL=false
TENANT_ID=
CLIENT_ID=
# Buzón personal de pruebas; debe coincidir con el usuario OAuth.
MAILBOX=
FOLDER_ID=inbox
# SEND requiere autorización explícita de cuenta y destinatario de prueba.
SEND_AUTHORIZED=false
RECIPIENT=
ALLOWED_RECIPIENTS=
RETENTION_DEBUG_DAYS=7
RETENTION_INFO_DAYS=15
RETENTION_ERROR_DAYS=30
RETENTION_EXPORT_DAYS=7
ANALYTICS_RETENTION_DAYS=90
# Supabase: ejecutar primero supabase/migrations/202611170001_rpa_logs.sql.
# Clave de servidor sb_secret_: solo en este archivo privado, nunca en HTML/chat/Git.
SUPABASE_ENABLED=false
SUPABASE_CONTEXT_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
LOG_SYNC_BATCH_SIZE=100
LOG_SYNC_MAX_BATCHES=5
LOG_SYNC_MAX_ATTEMPTS=3
LOG_SYNC_SECONDS=30
# Copias descargadas: runtime/logs/descargas. Retención desde su creación.
LOG_DOWNLOAD_DAYS=15
AUTO_CLEAN_LOGS=true
LOG_CLEANUP_INTERVAL_SECONDS=3600
# Gmail API: archivo OAuth de tipo Desktop, privado; no es la clave de Supabase.
GMAIL_CREDENTIALS_PATH=config/google/credentials.json
GMAIL_LABEL=INBOX
GMAIL_CAMPAIGN_TAG=

# Proveedor principal; SOURCE=FIXTURE permite demostración sin buzón.
MAIL_PROVIDER=gmail
GMAIL_SENDER_TOKEN_PATH=config/google/token_remitente.json
GMAIL_RECEIVER_TOKEN_PATH=config/google/token_receptor.json
GMAIL_SENDER_ADDRESS=
GMAIL_RECEIVER_ADDRESS=
REPORT_TO=
GMAIL_BATCH_SIZE=100
HTTP_TIMEOUT_SECONDS=30
OAUTH_TIMEOUT_SECONDS=180
RUN_DEADLINE_SECONDS=1800
DISPLAY_TIMEZONE=America/Santiago
